<section class="organization-buttons">
  <div class="container">
    <h2 class="section-heading">{{ section.settings.heading }}</h2>

    <div class="organization-grid">
      {% for block in section.blocks %}
        {% assign collection_handle = block.settings.collection_url | split: '/collections/' | last | split: '/' | first %}
        {% assign collection = collections[collection_handle] %}

        <div class="organization-item" {{ block.shopify_attributes }} data-organization-index="{{ forloop.index }}">
          <a href="{{ block.settings.collection_url }}" class="organization-link">
            <div class="organization-image-wrapper">
              {%- if section.settings.enable_slideshow and collection and collection.products.size > 0 -%}
                <div class="organization-slideshow" data-slideshow-id="organization-{{ forloop.index }}">
                  {% for product in collection.products limit: section.settings.slideshow_limit %}
                    {%- if product.featured_image -%}
                      <div class="slideshow-image {% if forloop.first %}active{% endif %}">
                        <img
                          src="{{ product.featured_image | img_url: '600x600' }}"
                          alt="{{ product.title }}"
                          class="organization-image"
                          loading="lazy"
                        >
                      </div>
                    {%- endif -%}
                  {% endfor %}

                  {% if collection.products.size == 0 %}
                    <div class="organization-image-placeholder">
                      {{ block.settings.organization_title }}
                    </div>
                  {% endif %}
                </div>
              {%- elsif block.settings.organization_image -%}
                <img
                  src="{{ block.settings.organization_image | img_url: '600x600' }}"
                  alt="{{ block.settings.organization_title }}"
                  class="organization-image"
                  loading="lazy"
                >
              {%- else -%}
                <div class="organization-image-placeholder">
                  {{ block.settings.organization_title }}
                </div>
              {%- endif -%}
            </div>
            <h3 class="organization-title">{{ block.settings.organization_title }}</h3>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  if (typeof initOrganizationSlideshows === 'undefined') {
    function initOrganizationSlideshows() {
      const slideshows = document.querySelectorAll('.organization-slideshow');

      slideshows.forEach(slideshow => {
        const slides = slideshow.querySelectorAll('.slideshow-image');
        if (slides.length <= 1) return;

        let currentIndex = 0;

        setInterval(() => {
          slides[currentIndex].classList.remove('active');
          currentIndex = (currentIndex + 1) % slides.length;
          slides[currentIndex].classList.add('active');
        }, {{ section.settings.slideshow_speed | times: 1000 }});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initOrganizationSlideshows);
    } else {
      initOrganizationSlideshows();
    }
  }
</script>

{% schema %}
{
  "name": "Organization Buttons",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "checkbox",
      "id": "enable_slideshow",
      "label": "Enable product slideshow",
      "default": true,
      "info": "Show product images from each collection as a slideshow"
    },
    {
      "type": "range",
      "id": "slideshow_limit",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "Number of products to show",
      "default": 5
    },
    {
      "type": "range",
      "id": "slideshow_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slideshow speed",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "organization",
      "name": "Organization Button",
      "settings": [
        {
          "type": "text",
          "id": "organization_title",
          "label": "Button Title"
        },
        {
          "type": "image_picker",
          "id": "organization_image",
          "label": "Button Image"
        },
        {
          "type": "url",
          "id": "collection_url",
          "label": "Collection URL",
          "info": "Link to the collection page (e.g., /collections/seasonal)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Organization Buttons",
      "blocks": [
        {
          "type": "organization",
          "settings": {
            "organization_title": "Seasonal",
            "collection_url": "/collections/seasonal"
          }
        },
        {
          "type": "organization",
          "settings": {
            "organization_title": "Clearance",
            "collection_url": "/collections/clearance"
          }
        }
      ]
    }
  ]
}
{% endschema %}
