# Apple Music API Configuration
# Get these from https://developer.apple.com/account/

# Optional: Your Apple Developer Team ID
APPLE_TEAM_ID=your_team_id

# Optional: Your MusicKit Key ID
APPLE_KEY_ID=your_key_id

# Optional: Path to your MusicKit private key (.p8 file)
APPLE_PRIVATE_KEY_PATH=path_to_your_private_key.p8

# Required for Apple Music API access
# Generate this using the Team ID, Key ID, and Private Key
APPLE_DEVELOPER_TOKEN=your_generated_jwt_token

# Optional: Required only if you want to create playlists in user's library
# Obtained through MusicKit JS authorization flow
APPLE_USER_TOKEN=your_user_token
