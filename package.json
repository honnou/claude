{
  "name": "historical-facts-music-playlist",
  "version": "1.0.0",
  "description": "Creates Apple Music playlists based on daily historical facts with regional music genres",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts"
  },
  "ts-node": {
